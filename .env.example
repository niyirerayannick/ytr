# Copy this file to .env and fill in real values for your environment.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use local SQLite. Example Postgres value:
# DATABASE_URL=postgres://user:password@localhost:5432/ytr
DATABASE_URL=

TIME_ZONE=Africa/Kigali

CONTACT_FALLBACK_EMAIL=hello@youthtimerevival.rw

# Public Google Meet room used for Tuesday and Thursday morning devotion.
MORNING_DEVOTION_URL=

# Email (defaults to console backend, which just prints emails to the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=hello@youthtimerevival.rw

# Production only: set this when TLS terminates at a trusted reverse proxy.
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Coolify production setup: docs/deployment-coolify.md
# CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# AWS_STORAGE_BUCKET_NAME=ytr-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=60
