# Copy this file to .env and fill in real values for your environment.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use local SQLite. Example Postgres value:
# DATABASE_URL=postgres://user:password@localhost:5432/ytr
DATABASE_URL=

TIME_ZONE=Africa/Kigali

CONTACT_FALLBACK_EMAIL=hello@youthtimerevival.rw

# Email (defaults to console backend, which just prints emails to the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=hello@youthtimerevival.rw
